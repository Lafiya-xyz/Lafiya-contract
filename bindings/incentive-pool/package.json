{
  "name": "@lafiya/incentive-pool",
  "version": "0.1.0",
  "description": "TypeScript bindings and event decoders for the Lafiya incentive-pool contract",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec dist/**/*.test.js",
    "test:watch": "node --test --watch dist/**/*.test.js",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lafiya/lafiya.git",
    "directory": "bindings/incentive-pool"
  },
  "keywords": [
    "lafiya",
    "stellar",
    "soroban",
    "bindings",
    "incentive-pool",
    "events"
  ]
}