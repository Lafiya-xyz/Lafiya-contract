{
  "flow": "enroll-with-credential",
  "title": "Enroll an attester with a licence credential",
  "actors": [
    "Registrar",
    "AttesterRegistry"
  ],
  "steps": [
    {
      "from": "Registrar",
      "to": "AttesterRegistry",
      "call": "enroll_with_credential",
      "auth": "Registrar"
    },
    {
      "from": "AttesterRegistry",
      "to": "AttesterRegistry",
      "call": "add_attester_with_info"
    },
    {
      "from": "AttesterRegistry",
      "event": "AttesterAdded"
    }
  ]
}
