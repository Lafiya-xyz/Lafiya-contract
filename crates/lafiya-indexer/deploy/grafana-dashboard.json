      "description": "Ingestion lag in ledgers: difference between the chain head ledger and the last ledger processed by the indexer. SLI: lafiya_indexer_ingestion_lag_ledgers.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(lafiya_indexer_ingestion_lag_ledgers)",
          "instant": true,
          "legendFormat": "lag (ledgers)",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Ingestion Lag (ledgers)",
      "type": "stat"
    },
