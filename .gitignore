# Rust build output
/target
**/*.rs.bk

# macOS metadata
.DS_Store

# Compiled WASM artefacts (generated — not committed)
*.wasm
# … except the contracts' own build output which stays under contracts/
!contracts/**/target

# Local environment and secrets
.env
.soroban

# Test snapshot files generated by insta / similar crates
test_snapshots/
**/*.snap
**/*.snap.new

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Editor and IDE directories
.idea/
.vscode/
*.swp
*.swo
*~

# Node / npm artefacts (generated bindings build output)
node_modules/
bindings/**/dist/
bindings/**/node_modules/

# Coverage reports
lcov.info
*.profraw
tarpaulin-report.html

# Temporary files
*.tmp
*.bak
