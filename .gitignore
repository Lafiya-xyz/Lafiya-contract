# Rust build output
/target
**/target/
**/*.rs.bk

# macOS metadata
.DS_Store

# Compiled WASM artefacts (generated — not committed)
*.wasm
# … except the contracts' own build output which stays under contracts/
!contracts/**/target

# Local environment and secrets
.env
.soroban

# Test snapshot files generated by insta / similar crates
test_snapshots/
**/*.snap
**/*.snap.new

# Python bytecode and caches
__pycache__/
.coverage
coverage.xml
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
