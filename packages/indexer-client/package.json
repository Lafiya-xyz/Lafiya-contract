{
  "name": "@lafiya/indexer-client",
  "version": "0.1.0",
  "description": "Typed fetch client for the Lafiya indexer API, generated from openapi.yaml",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "python3 ../../scripts/gen_indexer_client.py",
    "check:drift": "python3 ../../scripts/gen_indexer_client.py --check"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
